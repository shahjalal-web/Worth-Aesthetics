# Copy to .env (or .env.local) and fill in. Never commit real values.
SHOPIFY_STORE_DOMAIN=            # xxx.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN= # from Headless channel
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=# server-side only
SHOPIFY_API_VERSION=2026-07

SHOPIFY_APP_CLIENT_ID=           # Dev Dashboard app (scripts / webhooks)
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_REVALIDATION_SECRET=     # webhook HMAC secret (= app client secret for app-created webhooks)

SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=
SHOPIFY_ADMIN_ACCESS_TOKEN=      # scripts only, never in app runtime

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
KLAVIYO_PUBLIC_KEY=              # TBC — only if client uses Klaviyo
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=75   # USD, TBC

NEXT_PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=     # checkout domain (xxx.myshopify.com or checkout.yourdomain.com)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_PUBLIC_TOKEN= # public token only — safe for the browser
CUSTOMER_SESSION_SECRET=                 # random 32+ chars, encrypts customer session cookies
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=  # only for a confidential Customer Account API client
RESEND_API_KEY=                          # contact form (TBC)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
